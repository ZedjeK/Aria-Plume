{
    "name": "aria-plume",
    "productName": "Aria Plume",
    "version": "0.29.0",
    "description": "Correcteur et traducteur français ↔ anglais, 100 % local",
    "license": "GPL-3.0-only",
    "author": "ZedjeK",
    "type": "module",
    "main": "main.js",
    "private": true,
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder --win portable",
        "test": "node tests/smoke.mjs"
    },
    "devDependencies": {
        "electron": "44.7.0",
        "electron-builder": "26.17.0",
        "playwright": "1.56.0"
    },
    "build": {
        "appId": "io.github.zedjek.ariaplume",
        "productName": "Aria Plume",
        "directories": {
            "output": "dist"
        },
        "files": [
            "main.js",
            "engine.js",
            "settings.js",
            "preload.cjs",
            "ui/**",
            "build/*.png"
        ],
        "extraResources": [
            {
                "from": "../extension",
                "to": "aria",
                "filter": [
                    "core/**",
                    "engines/**",
                    "models/**",
                    "data/**"
                ]
            }
        ],
        "win": {
            "target": "portable",
            "icon": "build/icon-128.png"
        },
        "portable": {
            "artifactName": "Aria-Plume-${version}-portable.exe"
        }
    }
}
