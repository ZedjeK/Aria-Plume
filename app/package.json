{
    "name": "aria-plume",
    "productName": "Aria Plume",
    "version": "0.30.0",
    "description": "Correcteur et traducteur français ↔ anglais, 100 % local",
    "license": "GPL-3.0-only",
    "author": "ZedjeK",
    "type": "module",
    "main": "main.js",
    "private": true,
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder --win --x64",
        "test": "node tests/smoke.mjs"
    },
    "devDependencies": {
        "electron": "44.7.0",
        "electron-builder": "26.17.0",
        "playwright": "1.56.0"
    },
    "build": {
        "appId": "io.github.zedjek.ariaplume",
        "productName": "Aria Plume",
        "directories": {
            "output": "dist"
        },
        "files": [
            "main.js",
            "engine.js",
            "settings.js",
            "windows-input.js",
            "preload.cjs",
            "ui/**",
            "build/*.png"
        ],
        "extraResources": [
            {
                "from": "../extension",
                "to": "aria",
                "filter": [
                    "core/**",
                    "engines/**",
                    "models/**",
                    "data/**",
                    "popup/**",
                    "content/**",
                    "icons/**"
                ]
            }
        ],
        "win": {
            "target": [
                "portable",
                "zip"
            ],
            "icon": "build/icon-256.png",
            "artifactName": "Aria-Plume-${version}-win-x64.${ext}"
        },
        "portable": {
            "artifactName": "Aria-Plume-${version}-portable.exe"
        },
        "linux": {
            "target": "dir",
            "icon": "build/icon-256.png"
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ZedjeK/Aria-Plume.git"
    }
}
