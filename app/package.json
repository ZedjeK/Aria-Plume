{
    "name": "aria-plume",
    "productName": "Aria Plume",
    "version": "0.39.0",
    "description": "Correcteur et traducteur français ↔ anglais, 100 % local",
    "license": "GPL-3.0-only",
    "author": "ZedjeK",
    "type": "module",
    "main": "main.js",
    "private": true,
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder --win --x64 --publish never",
        "test": "node tests/extension-install.mjs && node tests/bridge.mjs && node tests/office.mjs && node tests/office-word.mjs && node tests/office-outlook.mjs && node tests/registry.mjs && node tests/updates.mjs && node tests/smoke.mjs",
        "test:package": "electron-builder --linux dir --x64 --publish never && APP_BINARY=$PWD/dist/linux-unpacked/aria-plume node tests/smoke.mjs && APP_BINARY=$PWD/dist/linux-unpacked/aria-plume node tests/mcp.mjs --app && node tests/package-accents.mjs",
        "test:mcp": "node tests/mcp.mjs && node tests/mcp.mjs --app"
    },
    "devDependencies": {
        "electron": "45.3.0",
        "electron-builder": "26.18.0",
        "playwright": "1.65.0"
    },
    "build": {
        "appId": "io.github.zedjek.ariaplume",
        "productName": "Aria Plume",
        "directories": {
            "output": "dist"
        },
        "files": [
            "main.js",
            "paths.js",
            "powershell.js",
            "app-main.js",
            "engine.js",
            "settings.js",
            "windows-input.js",
            "extension-install.js",
            "updates.js",
            "bridge/**",
            "office/**",
            "preload.cjs",
            "mcp/**",
            "ui/**",
            "build/*.png"
        ],
        "extraResources": [
            {
                "from": "../extension",
                "to": "aria",
                "filter": [
                    "core/**",
                    "engines/**",
                    "models/**",
                    "data/**",
                    "popup/**",
                    "content/**",
                    "icons/**",
                    "fonts/**",
                    "options/**",
                    "offscreen/**",
                    "test/**",
                    "manifest.json",
                    "background.js",
                    "bridge-client.js",
                    "THIRD_PARTY.md"
                ]
            },
            {
                "from": "../LICENSE",
                "to": "LICENSE"
            },
            {
                "from": "../LICENCES-TIERS.txt",
                "to": "LICENCES-TIERS.txt"
            }
        ],
        "win": {
            "target": [
                "portable",
                "zip"
            ],
            "icon": "build/icon-256.png",
            "artifactName": "Aria-Plume-${version}-win-x64.${ext}"
        },
        "portable": {
            "artifactName": "Aria-Plume-${version}-portable.exe"
        },
        "linux": {
            "target": "dir",
            "icon": "build/icon-256.png"
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ZedjeK/Aria-Plume.git"
    }
}
